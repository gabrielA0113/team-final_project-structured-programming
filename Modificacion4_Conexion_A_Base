# ==========================================
# FUNCIONES DE BASE DE DATOS (OPERACIONES EXTRA)
# ==========================================

def guardar_ticket_en_db(nombre_cliente, consumo, total):
    """Inserta datos reales en tus tablas 'usuario' y 'tickets'"""
    if conexion is None or not conexion.is_connected():
        print(f"{ROJO}[BD] No hay conexión activa. No se guardó en la base de datos.{RESET}")
        return

    try:
        cursor = conexion.cursor()
        
        # 1. Insertamos o actualizamos al usuario en la tabla 'usuario'
        query_usuario = "INSERT INTO usuario (id_usuario, nombre, correo, telefono, tipo) VALUES (1, %s, 'correo@cfe.com', '6181234567', 'Cliente') ON DUPLICATE KEY UPDATE nombre=%s"
        cursor.execute(query_usuario, (nombre_cliente, nombre_cliente))
        
        # 2. Insertamos el ticket en la tabla 'tickets' usando un ID único de ticket
        query_ticket = "INSERT INTO tickets (cliente, consumo, cantidad, fecha) VALUES (1, %s, %s, CURDATE())"
        cursor.execute(query_ticket, (consumo, total))
        
        conexion.commit()
        print(f"\033[32m[BD] ¡OPERACIÓN INSERT EXITOSA! Datos guardados en phpMyAdmin.\033[0m")
    except Exception as e:
        print(f"{ROJO}[BD] Error al insertar datos: {e}{RESET}")

def consultar_tabla_db():
    """Hace el SELECT con JOIN a tus tablas de phpMyAdmin y las muestra en la consola"""
    if conexion is None or not conexion.is_connected():
        print(f"{ROJO}[BD] No hay conexión activa para consultar.{RESET}")
        return

    try:
        cursor = conexion.cursor()
        query = """
            SELECT tickets.id_ticket, usuario.nombre, tickets.consumo, tickets.cantidad, tickets.fecha 
            FROM tickets 
            JOIN usuario ON tickets.cliente = usuario.id_usuario
        """
        cursor.execute(query)
        resultados = cursor.fetchall()
        
        print(f"\n{CIAN}=== CONSULTA SELECT DESDE LA BASE DE DATOS ==={RESET}")
        for fila in resultados:
            print(f"Ticket ID: {fila[0]} | Cliente: {fila[1]} | Consumo: {fila[2]} kWh | Total: ${fila[3]} | Fecha: {fila[4]}")
        print(f"{CIAN}=============================================={RESET}")
    except Exception as e:
        print(f"{ROJO}[BD] Error al consultar datos: {e}{RESET}")

